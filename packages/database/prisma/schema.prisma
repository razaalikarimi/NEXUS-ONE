// Prisma Schema — NEXUS ONE
// Phase 2: Full Shared Platform Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  member
  viewer
}

enum MembershipStatus {
  active
  invited
  suspended
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum ApiKeyStatus {
  active
  revoked
  expired
}

// ------------------------------------------------------------
// Core User & Auth
// ------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  passwordHash  String
  avatar        String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  memberships   Membership[]
  auditEvents   AuditEvent[]
  notifications Notification[]
  invitationsCreated Invitation[] @relation("InvitedByUser")

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  token        String    @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ------------------------------------------------------------
// Organizations & Workspaces (Multi-Tenancy)
// ------------------------------------------------------------

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  plan        String       @default("team") // starter, team, enterprise
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspaces  Workspace[]
  memberships Membership[]
  invitations Invitation[]
  apiKeys     ApiKey[]
  auditEvents AuditEvent[]
  notifications Notification[]
  workflows   Workflow[]
  workflowRuns WorkflowRun[]
  services    Service[]
  incidents   Incident[]
  errorGroups ErrorGroup[]
  alertRules  AlertRule[]
  gatewayRoutes    GatewayRoute[]
  gatewayConsumers GatewayConsumer[]
  gatewayMetrics   GatewayMetric[]

  @@map("organizations")
}

model Workspace {
  id          String       @id @default(uuid())
  orgId       String
  name        String
  slug        String
  settings    Json         @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workflows    Workflow[]
  workflowRuns WorkflowRun[]
  services     Service[]
  incidents    Incident[]
  errorGroups  ErrorGroup[]
  alertRules   AlertRule[]
  gatewayRoutes    GatewayRoute[]
  gatewayConsumers GatewayConsumer[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("workspaces")
}

model Membership {
  id        String           @id @default(uuid())
  userId    String
  orgId     String
  role      Role             @default(member)
  status    MembershipStatus @default(active)
  joinedAt  DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String           @id @default(uuid())
  orgId       String
  email       String
  role        Role             @default(member)
  token       String           @unique
  status      InvitationStatus @default(pending)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([token])
  @@index([email])
  @@map("invitations")
}

// ------------------------------------------------------------
// Audit Trail & Compliance
// ------------------------------------------------------------

model AuditEvent {
  id         String   @id @default(uuid())
  orgId      String
  userId     String?
  action     String   // e.g., "auth.login", "org.update", "member.invite"
  resource   String   // e.g., "organization", "api_key", "workspace"
  resourceId String?
  metadata   Json     @default("{}")
  ipAddress  String?
  timestamp  DateTime @default(now())

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, timestamp])
  @@index([userId])
  @@index([action])
  @@map("audit_events")
}

// ------------------------------------------------------------
// Notifications
// ------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  orgId     String
  type      String   // "system", "incident", "billing", "collaboration"
  title     String
  body      String
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([orgId])
  @@map("notifications")
}

// ------------------------------------------------------------
// API Keys
// ------------------------------------------------------------

model ApiKey {
  id         String       @id @default(uuid())
  orgId      String
  name       String
  hashedKey  String       @unique
  prefix     String       // e.g. "nx_live_..."
  scopes     String[]     @default(["*"])
  status     ApiKeyStatus @default(active)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([prefix])
  @@map("api_keys")
}

// ------------------------------------------------------------
// Phase 4: AgentForge — AI Agent Orchestration Platform
// ------------------------------------------------------------

enum WorkflowStatus {
  draft
  published
  archived
}

enum WorkflowNodeType {
  input
  prompt
  model
  tool
  condition
  transform
  approval
  output
}

enum WorkflowRunStatus {
  pending
  running
  completed
  failed
  cancelled
  waiting_approval
}

enum StepStatus {
  pending
  running
  completed
  failed
  skipped
  waiting_approval
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

model Workflow {
  id          String         @id @default(uuid())
  orgId       String
  workspaceId String
  name        String
  description String?
  status      WorkflowStatus @default(draft)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions     WorkflowVersion[]
  runs         WorkflowRun[]

  @@index([orgId, workspaceId])
  @@index([status])
  @@map("agentforge_workflows")
}

model WorkflowVersion {
  id         String   @id @default(uuid())
  workflowId String
  version    Int
  definition Json     @default("{}")
  changelog  String?
  createdAt  DateTime @default(now())

  workflow Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodes    WorkflowNode[]
  edges    WorkflowEdge[]
  runs     WorkflowRun[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("agentforge_workflow_versions")
}

model WorkflowNode {
  id        String           @id @default(uuid())
  versionId String
  nodeType  WorkflowNodeType
  label     String
  config    Json             @default("{}")
  positionX Float            @default(0)
  positionY Float            @default(0)

  version WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("agentforge_workflow_nodes")
}

model WorkflowEdge {
  id           String  @id @default(uuid())
  versionId    String
  sourceNodeId String
  targetNodeId String
  sourceHandle String?
  targetHandle String?
  condition    String?

  version WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("agentforge_workflow_edges")
}

model WorkflowRun {
  id          String            @id @default(uuid())
  orgId       String
  workspaceId String
  workflowId  String
  versionId   String
  status      WorkflowRunStatus @default(pending)
  triggeredBy String            @default("manual") // manual, api, schedule, webhook
  inputs      Json              @default("{}")
  outputs     Json              @default("{}")
  startedAt   DateTime?
  finishedAt  DateTime?
  error       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version      WorkflowVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  steps        WorkflowRunStep[]

  @@index([orgId, workspaceId])
  @@index([workflowId])
  @@index([status])
  @@map("agentforge_workflow_runs")
}

model WorkflowRunStep {
  id         String           @id @default(uuid())
  runId      String
  nodeId     String
  nodeType   WorkflowNodeType
  nodeLabel  String
  status     StepStatus       @default(pending)
  input      Json             @default("{}")
  output     Json             @default("{}")
  tokensUsed Int              @default(0)
  latencyMs  Int              @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?

  run       WorkflowRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  approvals WorkflowApproval[]

  @@index([runId])
  @@map("agentforge_run_steps")
}

model WorkflowApproval {
  id             String         @id @default(uuid())
  stepId         String
  status         ApprovalStatus @default(pending)
  reviewerId     String?
  decisionReason String?
  createdAt      DateTime       @default(now())
  decidedAt      DateTime?

  step WorkflowRunStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@map("agentforge_approvals")
}

// ------------------------------------------------------------
// Phase 5: PulseOps — AI Incident Management & Observability
// ------------------------------------------------------------

enum ServiceHealth {
  healthy
  degraded
  down
}

enum IncidentSeverity {
  critical
  high
  medium
  low
  info
}

enum IncidentStatus {
  open
  investigating
  resolved
  closed
}

enum ErrorGroupStatus {
  active
  resolved
  ignored
}

model Service {
  id          String        @id @default(uuid())
  orgId       String
  workspaceId String
  name        String
  slug        String
  description String?
  environment String        @default("production")
  status      ServiceHealth @default(healthy)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  telemetryEvents TelemetryEvent[]
  errorGroups     ErrorGroup[]
  incidents       Incident[]
  alertRules      AlertRule[]

  @@unique([orgId, slug])
  @@index([orgId, workspaceId])
  @@map("pulseops_services")
}

model TelemetryEvent {
  id           String           @id @default(uuid())
  orgId        String
  workspaceId  String
  serviceId    String
  errorGroupId String?
  eventType    String // error, latency, crash, info
  message      String
  stackTrace   String?
  fingerprint  String
  severity     IncidentSeverity @default(info)
  metadata     Json             @default("{}")
  timestamp    DateTime         @default(now())

  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  errorGroup ErrorGroup? @relation(fields: [errorGroupId], references: [id], onDelete: SetNull)

  @@index([serviceId, timestamp])
  @@index([fingerprint])
  @@map("pulseops_telemetry_events")
}

model ErrorGroup {
  id          String           @id @default(uuid())
  orgId       String
  workspaceId String
  serviceId   String
  fingerprint String
  title       String
  firstSeen   DateTime         @default(now())
  lastSeen    DateTime         @default(now())
  count       Int              @default(1)
  status      ErrorGroupStatus @default(active)

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  service      Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  events       TelemetryEvent[]

  @@unique([serviceId, fingerprint])
  @@index([orgId, workspaceId])
  @@index([lastSeen])
  @@map("pulseops_error_groups")
}

model Incident {
  id           String           @id @default(uuid())
  orgId        String
  workspaceId  String
  serviceId    String?
  title        String
  summary      String?
  severity     IncidentSeverity @default(medium)
  status       IncidentStatus   @default(open)
  rootCause    String?
  resolution   String?
  declaredById String?
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?
  updatedAt    DateTime         @updatedAt

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  service      Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  events       IncidentEvent[]

  @@index([orgId, workspaceId])
  @@index([status])
  @@index([severity])
  @@map("pulseops_incidents")
}

model IncidentEvent {
  id          String   @id @default(uuid())
  incidentId  String
  eventType   String // state_change, comment, ai_diagnosis, runbook_action
  message     String
  metadata    Json     @default("{}")
  createdById String?
  createdAt   DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("pulseops_incident_events")
}

model AlertRule {
  id                String           @id @default(uuid())
  orgId             String
  workspaceId       String
  serviceId         String?
  name              String
  conditionType     String // error_rate_spike, latency_p99, service_down
  threshold         Float
  timeWindowMinutes Int              @default(5)
  severity          IncidentSeverity @default(high)
  enabled           Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([orgId, workspaceId])
  @@index([enabled])
  @@map("pulseops_alert_rules")
}

// ------------------------------------------------------------
// Phase 6: GateFlow — API Gateway and Developer Platform
// ------------------------------------------------------------

enum RouteStatus {
  active
  inactive
  deprecated
}

enum ConsumerTier {
  free
  pro
  enterprise
}

model GatewayRoute {
  id               String       @id @default(uuid())
  orgId            String
  workspaceId      String
  name             String
  pathPattern      String       // e.g. "/api/v1/payments/*", "/webhooks/stripe"
  upstreamUrl      String       // e.g. "https://payments.internal.nexusone.dev:8443"
  methods          String[]     @default(["GET", "POST", "PUT", "PATCH", "DELETE"])
  stripPath        Boolean      @default(true)
  rateLimitRps     Int          @default(100)
  rateLimitBurst   Int          @default(200)
  corsEnabled      Boolean      @default(true)
  authRequired     Boolean      @default(true)
  transformHeaders Json         @default("{}") // injected/mutated headers
  timeoutMs        Int          @default(10000)
  status           RouteStatus  @default(active)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metrics      GatewayMetric[]

  @@unique([orgId, pathPattern])
  @@index([orgId, workspaceId])
  @@index([status])
  @@map("gateflow_routes")
}

model GatewayConsumer {
  id             String       @id @default(uuid())
  orgId          String
  workspaceId    String
  name           String
  tier           ConsumerTier @default(free)
  customQuotaRps Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKeys      GatewayApiKey[]
  metrics      GatewayMetric[]

  @@index([orgId, workspaceId])
  @@map("gateflow_consumers")
}

model GatewayApiKey {
  id          String    @id @default(uuid())
  consumerId  String
  keyPrefix   String    // e.g. "gf_live_..."
  hashedKey   String    @unique
  name        String?
  status      String    @default("active") // active, revoked, expired
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  consumer GatewayConsumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  @@index([consumerId])
  @@index([keyPrefix])
  @@map("gateflow_api_keys")
}

model GatewayMetric {
  id           String   @id @default(uuid())
  orgId        String
  routeId      String
  consumerId   String?
  statusCode   Int
  latencyMs    Int
  requestSize  Int      @default(0)
  responseSize Int      @default(0)
  timestamp    DateTime @default(now())

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  route        GatewayRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  consumer     GatewayConsumer? @relation(fields: [consumerId], references: [id], onDelete: SetNull)

  @@index([orgId, timestamp])
  @@index([routeId, timestamp])
  @@map("gateflow_metrics")
}



