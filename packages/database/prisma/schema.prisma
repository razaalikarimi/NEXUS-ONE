// Prisma Schema — NEXUS ONE
// Phase 2: Full Shared Platform Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  member
  viewer
}

enum MembershipStatus {
  active
  invited
  suspended
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum ApiKeyStatus {
  active
  revoked
  expired
}

// ------------------------------------------------------------
// Core User & Auth
// ------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  passwordHash  String
  avatar        String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  memberships   Membership[]
  auditEvents   AuditEvent[]
  notifications Notification[]
  invitationsCreated Invitation[] @relation("InvitedByUser")

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  token        String    @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ------------------------------------------------------------
// Organizations & Workspaces (Multi-Tenancy)
// ------------------------------------------------------------

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  plan        String       @default("team") // starter, team, enterprise
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspaces  Workspace[]
  memberships Membership[]
  invitations Invitation[]
  apiKeys     ApiKey[]
  auditEvents AuditEvent[]
  notifications Notification[]
  workflows   Workflow[]
  workflowRuns WorkflowRun[]

  @@map("organizations")
}

model Workspace {
  id          String       @id @default(uuid())
  orgId       String
  name        String
  slug        String
  settings    Json         @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workflows    Workflow[]
  workflowRuns WorkflowRun[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("workspaces")
}

model Membership {
  id        String           @id @default(uuid())
  userId    String
  orgId     String
  role      Role             @default(member)
  status    MembershipStatus @default(active)
  joinedAt  DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String           @id @default(uuid())
  orgId       String
  email       String
  role        Role             @default(member)
  token       String           @unique
  status      InvitationStatus @default(pending)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([token])
  @@index([email])
  @@map("invitations")
}

// ------------------------------------------------------------
// Audit Trail & Compliance
// ------------------------------------------------------------

model AuditEvent {
  id         String   @id @default(uuid())
  orgId      String
  userId     String?
  action     String   // e.g., "auth.login", "org.update", "member.invite"
  resource   String   // e.g., "organization", "api_key", "workspace"
  resourceId String?
  metadata   Json     @default("{}")
  ipAddress  String?
  timestamp  DateTime @default(now())

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, timestamp])
  @@index([userId])
  @@index([action])
  @@map("audit_events")
}

// ------------------------------------------------------------
// Notifications
// ------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  orgId     String
  type      String   // "system", "incident", "billing", "collaboration"
  title     String
  body      String
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([orgId])
  @@map("notifications")
}

// ------------------------------------------------------------
// API Keys
// ------------------------------------------------------------

model ApiKey {
  id         String       @id @default(uuid())
  orgId      String
  name       String
  hashedKey  String       @unique
  prefix     String       // e.g. "nx_live_..."
  scopes     String[]     @default(["*"])
  status     ApiKeyStatus @default(active)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([prefix])
  @@map("api_keys")
}

// ------------------------------------------------------------
// Phase 4: AgentForge — AI Agent Orchestration Platform
// ------------------------------------------------------------

enum WorkflowStatus {
  draft
  published
  archived
}

enum WorkflowNodeType {
  input
  prompt
  model
  tool
  condition
  transform
  approval
  output
}

enum WorkflowRunStatus {
  pending
  running
  completed
  failed
  cancelled
  waiting_approval
}

enum StepStatus {
  pending
  running
  completed
  failed
  skipped
  waiting_approval
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

model Workflow {
  id          String         @id @default(uuid())
  orgId       String
  workspaceId String
  name        String
  description String?
  status      WorkflowStatus @default(draft)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions     WorkflowVersion[]
  runs         WorkflowRun[]

  @@index([orgId, workspaceId])
  @@index([status])
  @@map("agentforge_workflows")
}

model WorkflowVersion {
  id         String   @id @default(uuid())
  workflowId String
  version    Int
  definition Json     @default("{}")
  changelog  String?
  createdAt  DateTime @default(now())

  workflow Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodes    WorkflowNode[]
  edges    WorkflowEdge[]
  runs     WorkflowRun[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("agentforge_workflow_versions")
}

model WorkflowNode {
  id        String           @id @default(uuid())
  versionId String
  nodeType  WorkflowNodeType
  label     String
  config    Json             @default("{}")
  positionX Float            @default(0)
  positionY Float            @default(0)

  version WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("agentforge_workflow_nodes")
}

model WorkflowEdge {
  id           String  @id @default(uuid())
  versionId    String
  sourceNodeId String
  targetNodeId String
  sourceHandle String?
  targetHandle String?
  condition    String?

  version WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("agentforge_workflow_edges")
}

model WorkflowRun {
  id          String            @id @default(uuid())
  orgId       String
  workspaceId String
  workflowId  String
  versionId   String
  status      WorkflowRunStatus @default(pending)
  triggeredBy String            @default("manual") // manual, api, schedule, webhook
  inputs      Json              @default("{}")
  outputs     Json              @default("{}")
  startedAt   DateTime?
  finishedAt  DateTime?
  error       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version      WorkflowVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  steps        WorkflowRunStep[]

  @@index([orgId, workspaceId])
  @@index([workflowId])
  @@index([status])
  @@map("agentforge_workflow_runs")
}

model WorkflowRunStep {
  id         String           @id @default(uuid())
  runId      String
  nodeId     String
  nodeType   WorkflowNodeType
  nodeLabel  String
  status     StepStatus       @default(pending)
  input      Json             @default("{}")
  output     Json             @default("{}")
  tokensUsed Int              @default(0)
  latencyMs  Int              @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?

  run       WorkflowRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  approvals WorkflowApproval[]

  @@index([runId])
  @@map("agentforge_run_steps")
}

model WorkflowApproval {
  id             String         @id @default(uuid())
  stepId         String
  status         ApprovalStatus @default(pending)
  reviewerId     String?
  decisionReason String?
  createdAt      DateTime       @default(now())
  decidedAt      DateTime?

  step WorkflowRunStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@map("agentforge_approvals")
}

