{
  "name": "@nexus-one/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run --pool=forks",
    "test:unit": "vitest run --pool=forks"
  },
  "dependencies": {
    "@nexus-one/database": "*",
    "@nexus-one/config": "*",
    "@nexus-one/logger": "*",
    "bcrypt": "^5.1.1",
    "crypto-random-string": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "typescript": "^5.5.4",
    "rimraf": "^6.0.1",
    "vitest": "^1.6.0"
  }
}
