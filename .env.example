# ============================================================
# NEXUS ONE — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file with real credentials.
# ============================================================

# ---- General ----
NODE_ENV=development
PORT=3001
DASHBOARD_URL=http://localhost:5173
MARKETING_URL=http://localhost:3000
API_URL=http://localhost:3001

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://nexusone:nexusone_dev@localhost:5432/nexusone_dev?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Session / Auth ----
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
SESSION_MAX_AGE_HOURS=24
BCRYPT_ROUNDS=12

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Rate Limiting ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ---- File Storage (S3-compatible) ----
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# ---- LLM Providers (AgentForge / CortexRAG) ----
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- Email (Notifications) ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@nexusone.dev

# ---- Observability ----
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=nexus-one-api
LOG_LEVEL=info

# ---- Analytics (optional) ----
# ANALYTICS_ENABLED=false
# ANALYTICS_ENDPOINT=
