# ---- API Server ----
FROM node:20-alpine AS base
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY package.json package-lock.json* ./
COPY apps/api/package.json ./apps/api/
COPY packages/database/package.json ./packages/database/
COPY packages/auth/package.json ./packages/auth/
COPY packages/config/package.json ./packages/config/
COPY packages/validators/package.json ./packages/validators/
COPY packages/types/package.json ./packages/types/
COPY packages/logger/package.json ./packages/logger/
COPY packages/integrations/package.json ./packages/integrations/
RUN npm ci --workspace=apps/api

# Build
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY . .
RUN npm run build -w packages/types
RUN npm run build -w packages/config
RUN npm run build -w packages/logger
RUN npm run build -w packages/validators
RUN npm run build -w packages/database
RUN npm run build -w packages/auth
RUN npm run build -w packages/integrations
RUN npm run build -w apps/api

# Production
FROM base AS runner
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nexusone
COPY --from=builder --chown=nexusone:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=nexusone:nodejs /app/packages ./packages
COPY --from=builder --chown=nexusone:nodejs /app/node_modules ./node_modules
USER nexusone
EXPOSE 3001
CMD ["node", "apps/api/dist/server.js"]
