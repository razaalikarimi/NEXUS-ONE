{
  "name": "@nexus-one/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run --dir src/__tests__/unit",
    "test:integration": "vitest run --dir src/__tests__/integration"
  },
  "dependencies": {
    "@nexus-one/database": "*",
    "@nexus-one/auth": "*",
    "@nexus-one/config": "*",
    "@nexus-one/validators": "*",
    "@nexus-one/types": "*",
    "@nexus-one/logger": "*",
    "@nexus-one/integrations": "*",
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "ioredis": "^5.4.1",
    "bullmq": "^5.12.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.0",
    "rimraf": "^6.0.1",
    "vitest": "^1.6.0",
    "@types/node": "^20.14.0"
  }
}
